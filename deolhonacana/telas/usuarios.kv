#:kivy 2.3.1

<TelaUsuarios>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.theme_cls.bg_darkest

        MDTopAppBar:
            title: "Usuários"
            left_action_items: [["arrow-left", lambda x: root.voltar(), "Voltar"]]
            right_action_items: [["refresh", lambda x: root.atualizar(), "Atualizar"]]
            elevation: 2

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(16)
            spacing: dp(12)

            MDCard:
                orientation: "vertical"
                size_hint_y: None
                height: dp(130)
                padding: dp(16)
                spacing: dp(12)
                radius: dp(10)
                elevation: 1

                MDLabel:
                    text: "Cadastrar usuário"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: dp(26)

                MDBoxLayout:
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(48)

                    MDTextField:
                        id: campo_login
                        hint_text: "Login"
                        mode: "rectangle"
                        icon_right: "account"
                        write_tab: False

                    MDTextField:
                        id: campo_nome
                        hint_text: "Nome completo"
                        mode: "rectangle"
                        write_tab: False

                    MDTextField:
                        id: campo_senha
                        hint_text: "Senha provisória"
                        mode: "rectangle"
                        icon_right: "lock"
                        password: True
                        write_tab: False

                    MDRectangleFlatIconButton:
                        id: botao_perfil
                        text: "operador"
                        icon: "menu-down"
                        size_hint: None, None
                        size: dp(150), dp(46)
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.opposite_bg_dark
                        line_color: app.theme_cls.divider_color
                        on_release: root.escolher_perfil()

                    MDRaisedButton:
                        text: "CADASTRAR"
                        size_hint: None, None
                        size: dp(150), dp(46)
                        on_release: root.cadastrar()

            MDBoxLayout:
                id: area_tabela

            MDBoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(12)

                MDLabel:
                    id: resumo
                    text: ""
                    font_style: "Caption"
                    theme_text_color: "Hint"
                    valign: "center"

                MDRectangleFlatIconButton:
                    text: "ATIVAR / DESATIVAR"
                    icon: "account-cancel-outline"
                    on_release: root.alternar_situacao()
