#:kivy 2.3.1

# Campo numérico que recalcula o resumo a cada digitação.
<CampoNumero@MDTextField>:
    mode: "rectangle"
    write_tab: False
    input_filter: "float"

<TelaQueima>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.theme_cls.bg_darkest

        MDTopAppBar:
            title: "Registrar queima"
            left_action_items: [["arrow-left", lambda x: root.voltar(), "Voltar"]]
            right_action_items: [["broom", lambda x: root.limpar(), "Limpar formulário"]]
            elevation: 2

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(24)
                spacing: dp(16)
                adaptive_height: True

                MDLabel:
                    text: "Local e equipe"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    MDTextField:
                        id: campo_data
                        hint_text: "Data"
                        mode: "rectangle"
                        icon_right: "calendar"
                        on_focus: if self.focus: root.escolher_data()

                    MDTextField:
                        id: campo_fazenda
                        hint_text: "Fazenda"
                        mode: "rectangle"
                        icon_right: "barn"
                        write_tab: False

                    MDTextField:
                        id: campo_gleba
                        hint_text: "Gleba"
                        mode: "rectangle"
                        write_tab: False

                    MDTextField:
                        id: campo_quadra
                        hint_text: "Quadra"
                        mode: "rectangle"
                        write_tab: False

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    MDTextField:
                        id: campo_viatura
                        hint_text: "Viatura"
                        mode: "rectangle"
                        icon_right: "fire-truck"
                        write_tab: False

                    MDTextField:
                        id: campo_hora_inicio
                        hint_text: "Início do combate (HH:MM)"
                        mode: "rectangle"
                        write_tab: False
                        on_text: root.atualizar_calculados()

                    MDTextField:
                        id: campo_hora_fim
                        hint_text: "Fim do combate (HH:MM)"
                        mode: "rectangle"
                        write_tab: False
                        on_text: root.atualizar_calculados()

                    MDTextField:
                        id: campo_colaboradores
                        hint_text: "Colaboradores"
                        mode: "rectangle"
                        input_filter: "int"
                        write_tab: False

                MDSeparator:

                MDLabel:
                    text: "Área atingida"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    CampoNumero:
                        id: campo_cana_ton
                        hint_text: "Cana (toneladas)"

                    CampoNumero:
                        id: campo_cana_ha
                        hint_text: "Cana (ha)"
                        on_text: root.atualizar_calculados()

                    CampoNumero:
                        id: campo_palha_ha
                        hint_text: "Palha (ha)"
                        on_text: root.atualizar_calculados()

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    CampoNumero:
                        id: campo_pasto_ha
                        hint_text: "Pasto (ha)"
                        on_text: root.atualizar_calculados()

                    CampoNumero:
                        id: campo_mata_ha
                        hint_text: "Mata (ha)"
                        on_text: root.atualizar_calculados()

                    CampoNumero:
                        id: campo_app_ha
                        hint_text: "APP (ha)"
                        on_text: root.atualizar_calculados()

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    MDRectangleFlatIconButton:
                        id: botao_colheu
                        text: "Já colheu: Não"
                        icon: "tractor"
                        size_hint: None, None
                        size: dp(200), dp(46)
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.opposite_bg_dark
                        line_color: app.theme_cls.divider_color
                        on_release: root.alternar_colheita()

                    MDLabel:
                        id: resumo
                        text: ""
                        font_style: "Body2"
                        theme_text_color: "Hint"
                        valign: "center"

                MDTextField:
                    id: campo_observacao
                    hint_text: "Observação"
                    mode: "rectangle"
                    multiline: True
                    max_text_length: 500
                    size_hint_y: None
                    height: dp(90)

                MDBoxLayout:
                    spacing: dp(16)
                    padding: 0, dp(8), 0, dp(8)
                    size_hint_y: None
                    height: dp(56)

                    Widget:

                    MDFlatButton:
                        text: "VOLTAR"
                        on_release: root.voltar()

                    MDRaisedButton:
                        text: "SALVAR QUEIMA"
                        icon: "content-save"
                        on_release: root.salvar()
