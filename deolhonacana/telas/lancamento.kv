#:kivy 2.3.1
#:import config deolhonacana.config
#:import registros deolhonacana.servicos.registros

# Botão que abre um menu suspenso, no lugar do Spinner do projeto antigo.
<BotaoSelecao@MDRectangleFlatIconButton>:
    icon: "menu-down"
    size_hint: 1, None
    height: dp(48)
    font_size: "14sp"
    theme_text_color: "Custom"
    text_color: app.theme_cls.opposite_bg_dark
    line_color: app.theme_cls.divider_color

<TelaLancamento>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.theme_cls.bg_darkest

        MDTopAppBar:
            title: "Lançar ocorrência"
            left_action_items: [["arrow-left", lambda x: root.voltar(), "Voltar"]]
            right_action_items: [["broom", lambda x: root.limpar(), "Limpar formulário"]]
            elevation: 2

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(24)
                spacing: dp(16)
                adaptive_height: True

                MDLabel:
                    text: "Identificação"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    MDTextField:
                        id: campo_data
                        hint_text: "Data da ocorrência"
                        mode: "rectangle"
                        icon_right: "calendar"
                        on_focus: if self.focus: root.escolher_data()

                    BotaoSelecao:
                        id: botao_gleba
                        text: "Selecione a gleba"
                        on_release: root.escolher_gleba()

                    MDTextField:
                        id: campo_quadra
                        hint_text: "Quadra"
                        mode: "rectangle"
                        icon_right: "grid"
                        write_tab: False

                MDLabel:
                    id: resumo_gleba
                    text: ""
                    font_style: "Caption"
                    theme_text_color: "Hint"
                    size_hint_y: None
                    height: dp(20)

                MDSeparator:

                MDLabel:
                    text: "Classificação"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(48)

                    BotaoSelecao:
                        id: botao_categoria
                        text: registros.PLACEHOLDER_CATEGORIA
                        on_release: root.escolher_categoria()

                    BotaoSelecao:
                        id: botao_servico
                        text: registros.PLACEHOLDER_SERVICO
                        on_release: root.escolher_servico()

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(96)

                    MDTextField:
                        id: campo_observacao
                        hint_text: "Observação"
                        mode: "rectangle"
                        multiline: True
                        max_text_length: 500
                        size_hint_x: 0.7

                    MDTextField:
                        id: campo_responsavel
                        hint_text: "Responsável indicado (opcional)"
                        mode: "rectangle"
                        icon_right: "account-hard-hat"
                        size_hint_x: 0.3

                MDSeparator:

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(28)

                    MDLabel:
                        text: "Registro fotográfico"
                        font_style: "Subtitle1"
                        bold: True

                    MDFlatButton:
                        text: "REMOVER FOTOS"
                        size_hint_x: None
                        width: dp(160)
                        on_release: root.remover_fotos()

                MDBoxLayout:
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(190)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(6)
                        Image:
                            id: foto_0
                            source: config.caminho_imagem("sem-foto.png")
                            allow_stretch: True
                            keep_ratio: True
                        MDFlatButton:
                            text: "ESCOLHER FOTO 1"
                            size_hint_x: 1
                            on_release: root.escolher_foto(0)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(6)
                        Image:
                            id: foto_1
                            source: config.caminho_imagem("sem-foto.png")
                            allow_stretch: True
                            keep_ratio: True
                        MDFlatButton:
                            text: "ESCOLHER FOTO 2"
                            size_hint_x: 1
                            on_release: root.escolher_foto(1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(6)
                        Image:
                            id: foto_2
                            source: config.caminho_imagem("sem-foto.png")
                            allow_stretch: True
                            keep_ratio: True
                        MDFlatButton:
                            text: "ESCOLHER FOTO 3"
                            size_hint_x: 1
                            on_release: root.escolher_foto(2)

                MDBoxLayout:
                    spacing: dp(16)
                    padding: 0, dp(8), 0, dp(8)
                    size_hint_y: None
                    height: dp(56)

                    Widget:

                    MDFlatButton:
                        text: "VOLTAR"
                        on_release: root.voltar()

                    MDRaisedButton:
                        text: "SALVAR OCORRÊNCIA"
                        icon: "content-save"
                        on_release: root.salvar()
